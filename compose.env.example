# Local Compose only. Copy to ignored compose.env, fill Supabase values and Groq key.
# Use a Supabase project with an asymmetric (ES256 or RS256) signing key.
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_PUBLISHABLE_KEY=your-public-publishable-key
GROQ_API_KEY=
POSTGRES_PASSWORD=contractiq-local-only
S3_ACCESS_KEY=contractiq-local
S3_SECRET_KEY=contractiq-local-password
# Optional fallback: a trusted, compatible chat-completions provider.
FALLBACK_BASE_URL=
FALLBACK_API_KEY=
FALLBACK_MODEL=
FALLBACK_STRUCTURED_MODE=json_object
TELEMETRY_ENABLED=false
