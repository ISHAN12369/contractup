# Required for chat and benefits; never expose this key to the browser.
GROQ_API_KEY=your_groq_api_key_here
GROQ_MODEL=openai/gpt-oss-20b
# Native strict JSON schema for the default model. For other models, explicitly
# choose json_object only after checking Groq's supported-model documentation.
STRUCTURED_MODE=json_schema

# Exact origins, comma separated. No wildcard, trailing slash or paths.
CORS_ORIGINS=http://localhost:3000
DATA_DIR=data
MODEL_CACHE_DIR=model-cache
DOCUMENT_TTL_SECONDS=3600
CLEANUP_INTERVAL_SECONDS=60
MAX_UPLOAD_BYTES=2097152
MAX_TEXT_CHARS=100000
MAX_CHUNKS=120
MAX_DOCUMENTS=20
RATE_LIMIT_REQUESTS=30
RATE_LIMIT_WINDOW_SECONDS=60
LLM_TIMEOUT_SECONDS=45
ANALYSIS_TIMEOUT_SECONDS=240
STRUCTURED_RETRIES=1
MAP_BATCH_CHARS=6000

# Phase 1: dense is the Phase 0 baseline; hybrid adds BM25 + RRF; the default reranks.
CHUNKING_STRATEGY=clause
RETRIEVER_STRATEGY=hybrid_rerank
RETRIEVAL_CANDIDATES=12
RERANKER_MODEL=Xenova/ms-marco-MiniLM-L-6-v2
# standard uses the pinned small English NER model; patterns is lighter but misses names.
PII_MODE=standard
PII_MODEL=en_core_web_sm
OCR_ENABLED=true
OCR_LANGUAGE=eng
MAX_OCR_PAGES=10
OCR_TIMEOUT_SECONDS=20
INDIA_RULE_PACK=true
AUDIT_MAX_CLAUSES=200

# Phase 3: local preserves the original single-user development service.
# Production refuses to start without every required infrastructure setting.
APP_MODE=local
DATABASE_URL=
REDIS_URL=
SUPABASE_URL=
S3_ENDPOINT=
S3_PUBLIC_ENDPOINT=
S3_BUCKET=contractiq
S3_REGION=us-east-1
S3_ACCESS_KEY=
S3_SECRET_KEY=
SIGNED_URL_SECONDS=60
INGESTION_TIMEOUT_SECONDS=600
CACHE_TTL_SECONDS=120
# Trusted HTTPS chat-completions-compatible endpoint, e.g. your second provider's /v1.
FALLBACK_BASE_URL=
FALLBACK_API_KEY=
FALLBACK_MODEL=
FALLBACK_STRUCTURED_MODE=json_object
# Opt-in: only operational metadata and token counts, never contract bodies/prompts.
TELEMETRY_ENABLED=false
SENTRY_DSN=
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_BASE_URL=https://cloud.langfuse.com
